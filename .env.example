# ===== 外贸客户知识库 .env 示例 =====
# 复制为 .env 并按需修改。所有 KB_ 前缀项见 app/config.py。

# ---------- LLM (生成) ----------
# provider: anthropic | openai (openai 走 OpenAI 兼容接口, 可指向第三方/自建网关)
KB_LLM_PROVIDER=openai
KB_LLM_MODEL=gpt-4o
# OpenAI 兼容接口 base URL; 留空=官方端点。可填第三方网关, 如:
#   https://api.openai.com/v1
#   https://your-gateway.example.com/v1
KB_LLM_API_BASE=https://api.openai.com/v1
# API key; 留空则回退 OPENAI_API_KEY (anthropic 回退 ANTHROPIC_API_KEY)
KB_LLM_API_KEY=sk-...
# 若用 anthropic:
# KB_LLM_PROVIDER=anthropic
# KB_LLM_MODEL=claude-sonnet-4-6
# KB_LLM_API_BASE=                  # 留空=官方端点
# KB_LLM_API_KEY=                   # 留空回退 ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# 兼容旧环境变量 (KB_LLM_API_KEY 留空时回退):
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---------- Embedding (向量化, 可与 LLM 分开配置) ----------
# provider: local (本地 bge-m3, 无需 API) | openai (OpenAI 兼容接口)
KB_EMBEDDING_PROVIDER=local
KB_EMBEDDING_MODEL=BAAI/bge-m3
KB_EMBEDDING_DIM=1024
# 仅 openai provider 生效; 可与 KB_LLM_API_BASE 不同 (如嵌入走另一网关)
# KB_EMBEDDING_API_BASE=https://embed.example.com/v1
# KB_EMBEDDING_API_KEY=sk-...        # 留空回退 OPENAI_API_KEY

# ---------- Reranker (本地, 首次自动下载) ----------
KB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- WhatsApp 采集 ----------
KB_FAST_TICK_SEC=2.0
KB_SLOW_TICK_SEC=30.0

# ---------- 数据目录 (默认 data/) ----------
# KB_DATA_DIR=data
# KB_SQLITE_PATH=data/kb.db
# KB_CHROMA_DIR=data/chroma
# KB_USER_DATA_DIR=data/user-data-dir
# KB_VAULT_EXPORT_DIR=data/vault
