# ===== 外贸客户知识库 .env 示例 =====
# 复制为 .env 并按需修改。所有 KB_ 前缀项见 app/config.py。

# ---------- LLM (生成) ----------
# provider: anthropic | openai (openai 走 OpenAI 兼容接口, 可指向第三方/自建网关)
KB_LLM_PROVIDER=openai
KB_LLM_MODEL=gpt-4o
# OpenAI 兼容接口 base URL; 留空=官方端点。可填第三方网关, 如:
#   https://api.openai.com/v1
#   https://your-gateway.example.com/v1
KB_LLM_API_BASE=https://api.openai.com/v1
# API key; 留空则回退 OPENAI_API_KEY (anthropic 回退 ANTHROPIC_API_KEY)
KB_LLM_API_KEY=sk-...
# 回复生成最大 token 数 (长回复不被截断; 分层/同义判断等短任务自动用更小值)
# KB_LLM_MAX_TOKENS=2048
# 若用 anthropic:
# KB_LLM_PROVIDER=anthropic
# KB_LLM_MODEL=claude-sonnet-4-6
# KB_LLM_API_BASE=                  # 留空=官方端点
# KB_LLM_API_KEY=                   # 留空回退 ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# 兼容旧环境变量 (KB_LLM_API_KEY 留空时回退):
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---------- 网络代理 (可选) ----------
# 若所在网络无法直连阿里云 (如公司内网/受限环境), 需配置代理。
# httpx 与 openai 库会自动读取以下标准环境变量 (也可在系统环境变量中设置):
#   HTTP_PROXY=http://proxy-host:port
#   HTTPS_PROXY=http://proxy-host:port
#   NO_PROXY=localhost,127.0.0.1
# 注意: 这些是标准环境变量, 不是 KB_ 前缀项, 不写入 .env 也能生效 (需在启动进程的环境里设置)。

# ---------- Embedding (向量化, 在线, 阿里云) ----------
# provider: openai (OpenAI 兼容接口, 阿里云 qwen3.7-text-embedding 等)
#   阿里云 OpenAI 兼容地址: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   (WorkspaceId 在阿里云控制台创建 API Key 时可见)
KB_EMBEDDING_PROVIDER=openai
KB_EMBEDDING_MODEL=qwen3.7-text-embedding
KB_EMBEDDING_DIM=1024
# 阿里云 OpenAI 兼容 base URL (含 /compatible-mode/v1)
KB_EMBEDDING_API_BASE=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
KB_EMBEDDING_API_KEY=sk-...        # 阿里云 DashScope API Key

# ---------- Reranker (重排, 在线, 阿里云) ----------
# provider: aliyun (阿里云 qwen3-rerank) | ollama (OpenAI 兼容接口 /v1)
KB_RERANKER_PROVIDER=aliyun
KB_RERANKER_MODEL=qwen3-rerank
# 阿里云 base URL (不含 /compatible-api, 适配器自动拼接 /compatible-api/v1/reranks)
KB_RERANKER_API_BASE=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
KB_RERANKER_API_KEY=sk-...   # 阿里云 DashScope API Key

# ---------- WhatsApp 采集 ----------
KB_FAST_TICK_SEC=2.0
KB_SLOW_TICK_SEC=30.0
# 自动扫描全部会话 (逐会话打开读取正文; 注意: 会把未读消息标记为已读)
# 默认关闭: 全量扫描会阻塞采集器导致实时失效; 改为「未读列表监控 + 点谁同步谁」
KB_AUTO_SCAN_CHATS=false
KB_AUTO_SCAN_INTERVAL_SEC=600.0
KB_AUTO_SCAN_MAX_CHATS=100
KB_AUTO_SCAN_SETTLE_SEC=1.5

# ---------- 数据目录 (默认 data/) ----------
# KB_DATA_DIR=data
# KB_SQLITE_PATH=data/kb.db
# KB_CHROMA_DIR=data/chroma
# KB_USER_DATA_DIR=data/user-data-dir
# KB_VAULT_EXPORT_DIR=data/vault

# ---------- 画像/分层/RAG 其他可调项 (可选, 通常用默认值) ----------
# KB_PROFILE_SUMMARY_MESSAGES=30   # 画像抽取/客户分析所用近期消息数
# KB_TIERING_ACTIVE_DAYS=30        # 分层: 近期活跃客户默认天数
# KB_TIERING_MAX_CUSTOMERS=50      # 分层: 单次任务客户数上限
# KB_CHUNK_SIZE=512                # RAG 切分大小
# KB_CHUNK_OVERLAP=64              # RAG 切分重叠
# KB_RERANK_TOP_K=8                # 重排后保留条数
# KB_CONTEXT_TOKEN_LIMIT=4000      # 上下文截断 token 上限
# KB_WIKI_DEDUP_THRESHOLD=0.85     # Wiki 实体去重余弦阈值
